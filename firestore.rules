// ============================================================
// The Sus Files — Firestore Security Rules
// ============================================================
// Paste these into Firebase Console > Firestore > Rules tab
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requesting user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // ========================
    // Users collection
    // ========================
    match /users/{uid} {
      // Users can read their own doc, and others can read to see profiles.
      // We allow write if authenticated to support adding friendIds without a backend.
      allow read, write: if isAuthenticated();
    }

    // ========================
    // Friends collection
    // ========================
    match /friends/{friendId} {
      allow read, write: if isAuthenticated();
    }

    // ========================
    // Cards collection
    // ========================
    match /cards/{cardId} {
      allow read, write: if isAuthenticated();
    }
    
    match /friendRequests/{requestId} {
      allow read, write: if isAuthenticated();
    }

    // ========================
    // Spaces collection
    // ========================
    match /spaces/{spaceId} {
      allow read, create, update: if isAuthenticated();
      // Only the admin of the space can delete it
      allow delete: if isAuthenticated() && resource.data.adminId == request.auth.uid;
    }

    // ========================
    // Space Invitations collection
    // ========================
    match /spaceInvitations/{invitationId} {
      allow read, write: if isAuthenticated();
    }

    // ========================
    // Usernames collection (Unique enforcement)
    // ========================
    match /usernames/{username} {
      allow read: if isAuthenticated();
      // Only allow creating or updating if claiming for yourself
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && request.resource.data.uid == request.auth.uid && resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }
  }
}
