// ============================================================
// The Sus Files — Firestore Security Rules
// ============================================================
// Secure Version

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requesting user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: check if the user is a registered user (not anonymous)
    function isRegisteredUser() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Helper: check if the user is only modifying themselves in an array field
    function isModifyingSelfInArray(field) {
      let oldArray = resource.data.get(field, []);
      let newArray = request.resource.data.get(field, []);
      
      // They added exactly one element, which is their own UID
      let isAdding = newArray.size() == oldArray.size() + 1 && newArray.hasAll(oldArray) && request.auth.uid in newArray;
      
      // They removed exactly one element, which is their own UID
      let isRemoving = oldArray.size() == newArray.size() + 1 && oldArray.hasAll(newArray) && !(request.auth.uid in newArray);
      
      return isAdding || isRemoving;
    }

    // ========================
    // Users collection
    // ========================
    match /users/{uid} {
      allow read: if isAuthenticated();
      // Allow users to update their own profile, OR allow others to ONLY add/remove themselves from friendIds
      allow update: if isAuthenticated() && (
        request.auth.uid == uid || 
        isModifyingSelfInArray('friendIds')
      );
      allow create: if isAuthenticated() && request.auth.uid == uid;
      allow delete: if isAuthenticated() && request.auth.uid == uid;
    }

    // ========================
    // Friends collection (Dummy suspects created by users)
    // ========================
    match /friends/{friendId} {
      allow read: if isAuthenticated();
      // Only registered users can create suspects
      allow create: if isRegisteredUser() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isRegisteredUser() && resource.data.createdBy == request.auth.uid;
    }

    // ========================
    // Cards collection
    // ========================
    match /cards/{cardId} {
      allow read: if isAuthenticated();
      // Only registered users can create cards
      allow create: if isRegisteredUser() && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
      // Allow the creator to update anything. Allow others to ONLY update reactions or positions (for Scatter view).
      // Note: Full security on `reactions` array is complex, but we allow position updates for the whiteboard feel.
      allow update: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'position'])
      );
    }
    
    // ========================
    // Friend Requests collection
    // ========================
    match /friendRequests/{requestId} {
      // Can read if you are sender or receiver
      allow read: if isAuthenticated() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if isRegisteredUser() && request.resource.data.from == request.auth.uid;
      // Can delete if you sent it (cancel) or if you received it (accept/decline)
      allow delete: if isAuthenticated() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow update: if false; // Requests should be deleted, not updated.
    }

    // ========================
    // Spaces collection
    // ========================
    match /spaces/{spaceId} {
      allow read: if isAuthenticated();
      allow create: if isRegisteredUser() && request.resource.data.adminId == request.auth.uid;
      // Users can modify spaces if they are admin, OR they are only adding/removing themselves from memberIds
      allow update: if isAuthenticated() && (
        resource.data.adminId == request.auth.uid ||
        isModifyingSelfInArray('memberIds')
      );
      // Only the admin of the space can delete it
      allow delete: if isAuthenticated() && resource.data.adminId == request.auth.uid;
    }

    // ========================
    // Space Invitations collection
    // ========================
    match /spaceInvitations/{invitationId} {
      allow read: if isAuthenticated() && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      allow create: if isRegisteredUser() && request.resource.data.fromUid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.toUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if isAuthenticated() && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
    }

    // ========================
    // Usernames collection (Unique enforcement)
    // ========================
    match /usernames/{username} {
      allow read: if isAuthenticated();
      // Only allow creating or updating if claiming for yourself
      allow create: if isRegisteredUser() && request.resource.data.uid == request.auth.uid;
      allow update: if isRegisteredUser() && request.resource.data.uid == request.auth.uid && resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // ========================
    // Notifications collection
    // ========================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.toUid == request.auth.uid;
      // Ensure the 'fromUid' matches the sender to prevent spoofing
      allow create: if isAuthenticated() && request.resource.data.fromUid == request.auth.uid; 
      allow update: if isAuthenticated() && resource.data.toUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAuthenticated() && resource.data.toUid == request.auth.uid;
    }
  }
}
