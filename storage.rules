rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper to check if user is a registered user (not guest)
    function isRegisteredUser() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      // Only the user themselves can write to their own folder, must be registered, and file size < 10MB
      allow write: if isRegisteredUser() 
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024;
    }
    
    // Deny all other paths by default (or allow read if needed)
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
